    {
      "name": "LinkedIn",
      "hosts": [
        "linkedin.com",
        "in.linkedin.com",
        "lnkd.in"
      ],
      "direct_patterns": [
        "/jobs/view/\\d+",
        "^/[A-Za-z0-9_-]+$"
      ],
      "bot_blocked": true
    },
    {
      "name": "Indeed",
      "hosts": [
        "indeed.com",
        "in.indeed.com",
        "indeed.co.in"
      ],
      "direct_patterns": [
        "viewjob\\?.*\\bjk=[A-Za-z0-9]+",
        "/viewjob\\?"
      ],
      "bot_blocked": true
    },
    {
      "name": "Naukri",
      "hosts": [
