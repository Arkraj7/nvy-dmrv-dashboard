# urbanforestpark.com job board - environment template
# Copy this file to `.env` (git-ignored) and fill in real values.
# scripts/fetch_and_humanize.py loads `.env` automatically when present.

# Google AI Studio key (https://aistudio.google.com/apikey).
# Required by the scraper/humanizer. Add the same value as a GitHub repo
# secret named GEMINI_API_KEY so .github/workflows/daily_jobs.yml can run.
GEMINI_API_KEY=

# Optional: force one specific Gemini model. By default the pipeline tries
# gemini-3.8-flash, then gemini-flash-latest, then gemini-3.1-flash-lite,
# then gemini-2.5-flash (skipping any that report as retired).
#GEMINI_MODEL=gemini-3.8-flash

# Optional: posting-age window in hours (default 24). Set 168 for a 7-day
# backfill sweep, e.g. LOOKBACK_HOURS=168 python scripts/fetch_and_humanize.py
#LOOKBACK_HOURS=24

# Cloudflare credentials used by `npm run deploy` (wrangler).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
